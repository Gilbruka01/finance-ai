{
  "name": "finance-ai",
  "private": true,
  "packageManager": "pnpm@11.29.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @finance-ai/web dev",
    "build": "pnpm --filter @finance-ai/web build",
    "typecheck": "pnpm --filter @finance-ai/web exec next typegen && tsc -p apps/web && tsc -p packages/tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.2",
    "vite": "8.3.8",
    "@vitest/coverage-v8": "5.1.2"
  }
}
